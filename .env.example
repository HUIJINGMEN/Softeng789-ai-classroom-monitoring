POSTGRES_DB=classroom_monitoring
POSTGRES_USER=classroom_user
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_PORT=5432

DATABASE_URL=jdbc:postgresql://localhost:5432/classroom_monitoring
SERVER_PORT=8080
VITE_API_BASE_URL=http://localhost:8080

# Used once to activate the passwordless administrator created by database/schema.sql.
# Leave blank after the first successful startup, or when using database/demo_data.sql.
BOOTSTRAP_ADMIN_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Login brute-force protection. Spring duration syntax accepts values such as 30s, 15m or 1h.
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_FAILURE_WINDOW=15m
AUTH_LOGIN_BLOCK_DURATION=15m

# Demo keeps delivery inside the app. Set to smtp and provide Spring mail settings to send email.
REPORT_EMAIL_PROVIDER=demo
REPORT_EMAIL_FROM=no-reply@classroomiq.local
FEEDBACK_SUMMARY_PROVIDER=demo
# Set to http after the FastAPI adapter and private Qwen server are running.
# Qwen report generation can take longer than the computer-vision endpoints.
FEEDBACK_SUMMARY_READ_TIMEOUT=90s

# Student self-registration is created only after all seven face captures pass verification.
# Keep http for the laboratory service. Use demo only for an explicit local UI demonstration.
FACE_ENROLLMENT_PROVIDER=http
AI_SERVICE_URL=http://127.0.0.1:8000
# Required by inbound AI event endpoints. Use a long random value shared only with the lab service.
AI_INGEST_KEY=

# Private report-summary inference. Use ollama/lmstudio locally or vllm in production.
LLM_RUNTIME=vllm
LLM_BASE_URL=http://127.0.0.1:8001
LLM_API_KEY=replace_with_a_private_inference_key
LLM_MODEL=Qwen/Qwen3-30B-A3B
LLM_TIMEOUT_SECONDS=90

# Production vLLM deployment tuning. These do not leak into application business logic.
VLLM_IMAGE=vllm/vllm-openai:v0.8.5
VLLM_PORT=8001
QWEN_MAX_MODEL_LEN=16384
QWEN_GPU_MEMORY_UTILIZATION=0.90
QWEN_TENSOR_PARALLEL_SIZE=1

# Private local storage for student bank-transfer receipts. Do not expose this directory directly.
BANK_TRANSFER_RECEIPT_DIR=../data/bank-transfer-receipts
